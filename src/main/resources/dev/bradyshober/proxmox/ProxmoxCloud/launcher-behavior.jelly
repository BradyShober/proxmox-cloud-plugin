<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form">
    <script type="text/javascript"><![CDATA[
    function findConnectorSelect() {
        var byName = document.querySelector('select[name$=".computerConnector"], select[name="computerConnector"], select[name$="computerConnector"]');
        if (byName) {
            return byName;
        }

        // Fallback: identify selector by known connector class values
        var allSelects = document.querySelectorAll('select');
        for (var i = 0; i < allSelects.length; i++) {
            var select = allSelects[i];
            for (var j = 0; j < select.options.length; j++) {
                var value = String(select.options[j].value || '');
                var text = String(select.options[j].text || '');
                if (value.indexOf('SSHConnector') > -1
                        || value.indexOf('ProxmoxJNLPConnector') > -1
                        || text.indexOf('SSH') > -1
                        || text.indexOf('JNLP') > -1) {
                    return select;
                }
            }
        }
        return null;
    }

    // Control SSH field visibility based on connector selection
    function updateSSHVisibility() {
        var sshFieldsWrapper = document.querySelector('[data-ssh-fields="true"]');
        if (!sshFieldsWrapper) {
            return;
        }

        var connectorSelect = findConnectorSelect();
        if (!connectorSelect) {
            return;
        }

        var selectedOption = connectorSelect.options[connectorSelect.selectedIndex];
        var selectedText = selectedOption ? String(selectedOption.text || '') : '';
        var selectedValue = selectedOption ? String(selectedOption.value || '') : '';
        var isSsh = selectedText.indexOf('SSH') > -1 || selectedValue.indexOf('SSHConnector') > -1;

        sshFieldsWrapper.style.display = isSsh ? '' : 'none';
    }

    // Call on DOMContentLoaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(updateSSHVisibility, 200);
        });
    } else {
        setTimeout(updateSSHVisibility, 200);
    }

    // Set up change listeners after jelly controls render
    setTimeout(function() {
        var connectorSelect = findConnectorSelect();
        if (connectorSelect) {
            connectorSelect.addEventListener('change', function() {
                updateSSHVisibility();
            });
        }
        updateSSHVisibility();
    }, 300);
    ]]></script>
</j:jelly>

