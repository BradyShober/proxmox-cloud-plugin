<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form" xmlns:c="/lib/credentials">

    <f:entry title="${%Cloud Name}" field="name">
        <f:textbox placeholder="proxmox-cloud"/>
    </f:entry>

    <f:entry title="${%Proxmox Host}" field="host">
        <f:textbox placeholder="https://proxmox.example.com:8006"/>
    </f:entry>

    <f:entry title="${%Proxmox Node Name}" field="node">
        <f:textbox placeholder="pve"/>
    </f:entry>

    <f:entry title="${%Proxmox API Token Credential}" field="apiTokenCredentialId">
        <c:select/>
    </f:entry>

    <f:entry title="${%Skip TLS Certificate Validation (Insecure)}" field="skipTlsVerification">
        <f:checkbox default="false"/>
    </f:entry>

    <f:entry title="${%Template VM ID}" field="templateVmId">
        <f:textbox placeholder="100"/>
    </f:entry>

    <f:entry title="${%Agent Name Template}" field="agentNameTemplate">
        <f:textbox default="proxmox-agent" placeholder="proxmox-agent"/>
    </f:entry>

    <f:entry title="${%Max Instances}" field="maxInstances">
        <f:number default="5"/>
    </f:entry>

    <f:entry title="${%Min Instances}" field="minInstances">
        <f:number default="0" min="0"/>
    </f:entry>

    <f:entry title="${%Idle Minutes Before Termination}" field="idleMinutesBeforeTermination">
        <f:number default="5" min="1"/>
    </f:entry>

    <f:entry title="${%Max Lifetime Minutes (0 = disabled)}" field="maxLifetimeMinutes">
        <f:number default="0" min="0"/>
    </f:entry>

    <f:dropdownDescriptorSelector title="${%Agent Launcher}" field="launcher"/>

    <!-- SSH fields - visibility controlled by JavaScript -->
    <div data-ssh-fields="true">
        <f:entry title="${%Agent SSH Username for cloud-init}" field="sshUsername">
            <f:textbox default="jenkins" placeholder="jenkins" id="ssh-username-input"/>
        </f:entry>

        <f:entry title="${%Agent SSH Public Key for cloud-init}" field="sshPublicKey">
            <f:textarea id="ssh-publickey-input"/>
        </f:entry>
    </div>

    <f:entry title="${%Agent Remote FS Root}" field="remoteFsRoot">
        <f:textbox default="/home/jenkins" placeholder="/home/jenkins"/>
    </f:entry>

    <f:entry title="${%Agent Labels}" field="labels">
        <f:textbox default="proxmox" placeholder="proxmox linux docker"/>
    </f:entry>

    <st:include page="launcher-behavior.jelly"/>

</j:jelly>

